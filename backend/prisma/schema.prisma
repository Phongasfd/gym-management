// Prisma schema. Invariants that Prisma cannot express (CHECK constraints) live in the
// migrations; see 20261105100000_booking_waitlist_outbox_reconciliation.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  active
  waitlisted
  cancelled
}

enum SubscriptionStatus {
  pending // created when the member starts a VNPay payment
  active
  failed // VNPay reported a failed payment, or it was never paid before the link expired
  expired
}

enum TokenUserType {
  member
  staff
}

enum OutboxStatus {
  pending
  processing
  done
  failed // gave up after the maximum number of attempts (dead letter)
}

model User {
  id String @id @default(uuid())

  email         String  @unique
  password_hash String
  full_name     String?
  role          String
  is_active     Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Package {
  id            String   @id @default(uuid())
  name          String
  description   String?
  price         Decimal
  duration_days Int
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  subscriptions Subscription[]
}

model Member {
  id String @id @default(uuid())

  // OAuth
  googleId   String? @unique
  facebookId String? @unique

  full_name     String
  phone         String?
  email         String    @unique
  gender        String?
  date_of_birth DateTime?
  password_hash String?

  // Password reset
  reset_code         String? // SHA-256 of the 6-digit code
  reset_code_expires DateTime?
  reset_attempts     Int       @default(0)

  isProfileComplete Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  subscriptions Subscription[]
  checkins      Checkin[]
  bookings      Booking[]
}

// A subscription is also the payment order: its id (without dashes) is the VNPay vnp_TxnRef.
model Subscription {
  id         String             @id @default(uuid())
  member_id  String
  package_id String
  start_date DateTime?
  end_date   DateTime?
  status     SubscriptionStatus
  created_at DateTime           @default(now())

  // Payment. `amount` is the package price when the order was created, so a later price change
  // cannot make a genuine payment fail the amount check.
  amount             Decimal?
  vnp_create_date    String? // yyyyMMddHHmmss (GMT+7) sent to VNPay; querydr needs it back
  vnp_transaction_no String?
  paid_at            DateTime?
  failure_reason     String?

  // Reconciliation of orders whose IPN never arrived
  reconcile_attempts Int       @default(0)
  next_reconcile_at  DateTime?

  member  Member  @relation(fields: [member_id], references: [id])
  package Package @relation(fields: [package_id], references: [id])

  @@index([member_id])
  @@index([package_id])
  @@index([status, next_reconcile_at])
}

model Checkin {
  id           String   @id @default(uuid())
  member_id    String
  checkin_time DateTime
  source       String?

  member Member @relation(fields: [member_id], references: [id])

  @@index([member_id])
  @@index([checkin_time])
}

model Class {
  id            String    @id @default(uuid())
  name          String
  coach_name    String?
  schedule_time DateTime?
  end_time      DateTime?
  capacity      Int
  // Seats held by `active` bookings. Kept in the same transaction as every booking change and
  // guarded by CHECK (booked_count BETWEEN 0 AND capacity), so the database itself refuses
  // to overbook even if application code is wrong.
  booked_count  Int       @default(0)
  created_at    DateTime  @default(now())

  bookings Booking[]
}

model Booking {
  id            String        @id @default(uuid())
  class_id      String
  member_id     String
  status        BookingStatus
  // Set when the booking joins the waitlist. The queue is ordered by waitlist_seq, a value from
  // the "Booking_waitlist_seq" sequence taken while the class row is locked, so it follows the
  // order in which members actually joined (timestamps from different requests do not).
  waitlisted_at DateTime?
  waitlist_seq  BigInt?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @default(now()) @updatedAt

  member Member @relation(fields: [member_id], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@unique([member_id, class_id]) // one row per member and class; re-booking re-activates it
  @@index([member_id])
  @@index([class_id, status, waitlist_seq])
}

model RefreshToken {
  id            String        @id @default(uuid())
  user_id       String
  user_type     TokenUserType
  token_hash    String
  revoked       Boolean       @default(false)
  replaced_by   String?
  expires_at    DateTime
  created_at    DateTime      @default(now())
  created_by_ip String?
  user_agent    String?

  @@index([user_id])
  @@index([token_hash])
  @@index([expires_at])
}

// Transactional outbox: events are written in the same transaction as the state change that
// causes them, then delivered at least once by the worker (src/worker.ts).
model OutboxEvent {
  id           String       @id @default(uuid())
  type         String
  payload      Json
  status       OutboxStatus @default(pending)
  attempts     Int          @default(0)
  available_at DateTime     @default(now())
  locked_at    DateTime?
  last_error   String?
  created_at   DateTime     @default(now())
  processed_at DateTime?

  @@index([status, available_at])
}
